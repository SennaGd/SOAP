{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soap",
  "version": "7.23.1",
  "identifier": "com.soap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SOAP",
        "width": 1280,
        "height": 720,
		"minWidth": 960,
		"minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/favicon.ico"
      
    ]
  }
}
